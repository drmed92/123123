<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Shown only when opened for a specific widget -->
        <RadioGroup
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This widget shows"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/mode_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outdoor (IQAir)" />

            <RadioButton
                android:id="@+id/mode_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indoor (sensor)" />

            <RadioButton
                android:id="@+id/mode_both"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indoor vs outdoor" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IQAir API key"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Paste your key"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="Free key: https://dashboard.iqair.com → Air quality API → Create key" />

        <TextView
            android:id="@+id/place"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose city" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Indoor sensor: ThingSpeak channel ID"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/channel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 3427507"
            android:importantForAutofill="no"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Public channel with fields named pm2.5, pm10, co2, temp, hum. PM2.5 and PM10 become US AQI with the EPA formula IQAir uses; CO₂, temperature and humidity are shown as measured." />

        <TextView
            android:id="@+id/every"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="20"
            android:min="1" />

        <TextView
            android:id="@+id/quota"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/notify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Show AQI on lock screen, Always On Display and status bar" />

        <Button
            android:id="@+id/battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Allow background updates (battery)" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Save &amp; update now" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="12dp" />
    </LinearLayout>
</ScrollView>
