<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="3dp" />
            <gradient android:angle="270" android:startColor="#E3E2DA" android:endColor="#F2F1EB" />
            <stroke android:width="1dp" android:color="#003C74" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="3dp" />
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#E3E0D3" />
            <stroke android:width="1dp" android:color="#003C74" />
        </shape>
    </item>
</selector>
